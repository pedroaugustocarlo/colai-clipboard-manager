<Window
    x:Class="ClipboardManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:ClipboardManager"
    xmlns:helpers="clr-namespace:ClipboardManager.Helpers"
    mc:Ignorable="d"
    Icon="Assets/colai_16_16.ico"
    Title="{x:Static local:AppInfo.FullName}"
    Height="470"
    Width="440"
    ShowInTaskbar="False"
    WindowState="Minimized"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <helpers:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility"/>

        <!-- Botão de ícone: fixar -->
        <Style
            x:Key="PinIconButtonStyle"
            TargetType="Button"
        >
            <Setter
                Property="Width"
                Value="24"/>
            <Setter
                Property="Height"
                Value="24"/>
            <Setter
                Property="Background"
                Value="Transparent"/>
            <Setter
                Property="BorderThickness"
                Value="0"/>
            <Setter
                Property="FontSize"
                Value="13"/>
            <Setter
                Property="Cursor"
                Value="Hand"/>
            <Setter
                Property="FocusVisualStyle"
                Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            CornerRadius="12"
                        >
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger
                                Property="IsMouseOver"
                                Value="True"
                            >
                                <Setter
                                    TargetName="Bg"
                                    Property="Background"
                                    Value="{StaticResource AccentSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Caixa de edição do nome. Template próprio porque o padrão do -->
        <!-- WPF força a borda azul do sistema no foco e no hover. -->
        <Style
            x:Key="NameTextBoxStyle"
            TargetType="TextBox"
        >
            <Setter
                Property="FontSize"
                Value="11"/>
            <Setter
                Property="FontWeight"
                Value="SemiBold"/>
            <Setter
                Property="Foreground"
                Value="{StaticResource TextPrimaryBrush}"/>
            <Setter
                Property="Background"
                Value="{StaticResource CardBackgroundBrush}"/>
            <Setter
                Property="BorderBrush"
                Value="{StaticResource AccentBrush}"/>
            <Setter
                Property="BorderThickness"
                Value="1"/>
            <Setter
                Property="CaretBrush"
                Value="{StaticResource AccentBrush}"/>
            <Setter
                Property="SelectionBrush"
                Value="{StaticResource AccentBrush}"/>
            <Setter
                Property="SelectionOpacity"
                Value="0.3"/>
            <Setter
                Property="MinHeight"
                Value="22"/>
            <Setter
                Property="VerticalContentAlignment"
                Value="Center"/>
            <Setter
                Property="FocusVisualStyle"
                Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                        >
                            <Grid>
                                <!-- Placeholder exibido enquanto a caixa está vazia -->
                                <TextBlock
                                    x:Name="Placeholder"
                                    Text="Dê um nome a este item…"
                                    FontWeight="Normal"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Margin="6,0,4,0"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed"/>
                                <ScrollViewer
                                    x:Name="PART_ContentHost"
                                    Margin="4,0"
                                    VerticalAlignment="Center"
                                    Focusable="False"
                                    HorizontalScrollBarVisibility="Hidden"
                                    VerticalScrollBarVisibility="Hidden"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger
                                Property="Text"
                                Value=""
                            >
                                <Setter
                                    TargetName="Placeholder"
                                    Property="Visibility"
                                    Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão de ícone: mover para cima/baixo -->
        <Style
            x:Key="ArrowIconButtonStyle"
            TargetType="Button"
        >
            <Setter
                Property="Width"
                Value="20"/>
            <Setter
                Property="Height"
                Value="20"/>
            <Setter
                Property="Background"
                Value="Transparent"/>
            <Setter
                Property="Foreground"
                Value="{StaticResource TextSecondaryBrush}"/>
            <Setter
                Property="BorderThickness"
                Value="0"/>
            <Setter
                Property="FontFamily"
                Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter
                Property="FontSize"
                Value="10"/>
            <Setter
                Property="Cursor"
                Value="Hand"/>
            <Setter
                Property="FocusVisualStyle"
                Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                        >
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger
                                Property="IsMouseOver"
                                Value="True"
                            >
                                <Setter
                                    TargetName="Bg"
                                    Property="Background"
                                    Value="{StaticResource CardBackgroundBrush}"/>
                                <Setter
                                    Property="Foreground"
                                    Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger
                                Property="IsEnabled"
                                Value="False"
                            >
                                <Setter
                                    Property="Opacity"
                                    Value="0.3"/>
                                <Setter
                                    Property="Cursor"
                                    Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão de ícone: excluir -->
        <Style
            x:Key="DeleteIconButtonStyle"
            TargetType="Button"
        >
            <Setter
                Property="Width"
                Value="24"/>
            <Setter
                Property="Height"
                Value="24"/>
            <Setter
                Property="Background"
                Value="Transparent"/>
            <Setter
                Property="BorderThickness"
                Value="0"/>
            <Setter
                Property="FontSize"
                Value="13"/>
            <Setter
                Property="Cursor"
                Value="Hand"/>
            <Setter
                Property="FocusVisualStyle"
                Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            CornerRadius="12"
                        >
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger
                                Property="IsMouseOver"
                                Value="True"
                            >
                                <Setter
                                    TargetName="Bg"
                                    Property="Background"
                                    Value="{StaticResource DangerSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão "pill" de rodapé -->
        <Style
            x:Key="ClearHistoryButtonStyle"
            TargetType="Button"
        >
            <Setter
                Property="Background"
                Value="{StaticResource CardBackgroundBrush}"/>
            <Setter
                Property="Foreground"
                Value="{StaticResource AccentBrush}"/>
            <Setter
                Property="BorderBrush"
                Value="{StaticResource AccentBrush}"/>
            <Setter
                Property="BorderThickness"
                Value="1.4"/>
            <Setter
                Property="FontWeight"
                Value="SemiBold"/>
            <Setter
                Property="FontSize"
                Value="12"/>
            <Setter
                Property="Cursor"
                Value="Hand"/>
            <Setter
                Property="FocusVisualStyle"
                Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="18"
                        >
                            <ContentPresenter
                                x:Name="Content"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="14,0"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger
                                Property="IsMouseOver"
                                Value="True"
                            >
                                <Setter
                                    TargetName="Bg"
                                    Property="Background"
                                    Value="{StaticResource AccentBrush}"/>
                                <Setter
                                    Property="Foreground"
                                    Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Remove a chrome padrão de seleção/hover do ListBoxItem: quem -->
        <!-- controla a aparência é o Border do DataTemplate. -->
        <Style
            x:Key="ClipboardListBoxItemStyle"
            TargetType="ListBoxItem"
        >
            <Setter
                Property="Padding"
                Value="0"/>
            <Setter
                Property="Margin"
                Value="0,0,0,8"/>
            <Setter
                Property="Background"
                Value="Transparent"/>
            <Setter
                Property="HorizontalContentAlignment"
                Value="Stretch"/>
            <Setter
                Property="FocusVisualStyle"
                Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Card: única superfície visível; a margem ao redor é -->
        <!-- transparente e dá espaço para a sombra "flutuar". -->
        <Border
            Margin="10"
            Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource BorderSoftBrush}"
            BorderThickness="1"
            CornerRadius="10"
        >
            <Border.Effect>
                <DropShadowEffect
                    Color="#000000"
                    Opacity="0.22"
                    BlurRadius="12"
                    ShadowDepth="2"
                    Direction="270"/>
            </Border.Effect>

            <Grid Margin="16,14,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cabeçalho: também funciona como "alça" para arrastar a janela -->
                <Grid
                    Grid.Row="0"
                    Margin="2,0,2,12"
                    Background="Transparent"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown"
                >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="{x:Static local:AppInfo.Name}"
                        FontSize="17"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        VerticalAlignment="Center"/>

                    <Border
                        Grid.Column="1"
                        Background="{StaticResource AccentSoftBrush}"
                        CornerRadius="9"
                        Padding="9,3"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                    >
                        <TextBlock
                            Text="{Binding TotalItems}"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource AccentBrush}"/>
                    </Border>

                    <Button
                        Grid.Column="2"
                        Content="✕"
                        Style="{StaticResource NeutralIconButtonStyle}"
                        Click="HideButton_Click"
                        ToolTip="Ocultar (Esc)"/>
                </Grid>

                <!-- Lista de itens -->
                <ListBox
                    Grid.Row="1"
                    ItemsSource="{Binding Items}"
                    ItemContainerStyle="{StaticResource ClipboardListBoxItemStyle}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0,0,3,0"
                    HorizontalContentAlignment="Stretch"
                    ScrollViewer.CanContentScroll="False"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ScrollViewer.PanningMode="VerticalOnly"
                    ScrollViewer.PanningDeceleration="0.001"
                >
                    <ListBox.Resources>
                        <!-- Scrollbar fina e discreta, no lugar da padrão do Windows -->
                        <Style TargetType="ScrollBar">
                            <Setter
                                Property="Width"
                                Value="8"/>
                            <Setter
                                Property="Background"
                                Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <Track
                                            Name="PART_Track"
                                            IsDirectionReversed="True"
                                        >
                                            <Track.Thumb>
                                                <Thumb Width="6">
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border
                                                                Background="{StaticResource BorderSoftBrush}"
                                                                CornerRadius="4"/>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton
                                                    Command="ScrollBar.PageDownCommand"
                                                    Opacity="0"
                                                    Focusable="False"/>
                                            </Track.IncreaseRepeatButton>
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton
                                                    Command="ScrollBar.PageUpCommand"
                                                    Opacity="0"
                                                    Focusable="False"/>
                                            </Track.DecreaseRepeatButton>
                                        </Track>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Resources>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border
                                x:Name="ItemCard"
                                Height="60"
                                Padding="8,8,2,8"
                                CornerRadius="8"
                                BorderThickness="1"
                                HorizontalAlignment="Stretch"
                                MouseLeftButtonDown="ClipboardItem_MouseLeftButtonDown"
                            >
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter
                                            Property="Background"
                                            Value="{StaticResource CardBackgroundBrush}"/>
                                        <Setter
                                            Property="BorderBrush"
                                            Value="{StaticResource BorderSoftBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger
                                                Binding="{Binding IsPinned}"
                                                Value="True"
                                            >
                                                <Setter
                                                    Property="BorderBrush"
                                                    Value="{StaticResource AccentBrush}"/>
                                            </DataTrigger>
                                            <Trigger
                                                Property="IsMouseOver"
                                                Value="True"
                                            >
                                                <Setter
                                                    Property="Background"
                                                    Value="{StaticResource AccentSoftBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Conteúdo -->
                                    <StackPanel
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Margin="0,0,4,0"
                                    >
                                        <Grid>
                                            <!-- Nome (se houver) ou conteúdo. Itens com nome -->
                                            <!-- ganham um ícone de etiqueta na cor de destaque. -->
                                            <DockPanel
                                                ToolTip="{Binding DisplayToolTip}"
                                                Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibility}}"
                                            >
                                                <TextBlock
                                                    DockPanel.Dock="Left"
                                                    Text="&#xE8EC;"
                                                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                    FontSize="11"
                                                    Foreground="{StaticResource AccentBrush}"
                                                    VerticalAlignment="Center"
                                                    Margin="0,1,5,0"
                                                    Visibility="{Binding HasName, Converter={StaticResource BoolToVisibility}}"/>
                                                <TextBlock
                                                    Text="{Binding DisplayText}"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource TextPrimaryBrush}"
                                                    VerticalAlignment="Center"
                                                    TextWrapping="NoWrap"
                                                    TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>

                                            <!-- Edição do nome direto no card. -->
                                            <!-- Enter/perder o foco salva; Esc cancela; vazio remove o nome. -->
                                            <TextBox
                                                Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                MaxLength="{Binding DataContext.MaxNameLength, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Style="{StaticResource NameTextBoxStyle}"
                                                Margin="-4,-3,0,-3"
                                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                                                IsVisibleChanged="NameTextBox_IsVisibleChanged"
                                                PreviewKeyDown="NameTextBox_PreviewKeyDown"
                                                LostKeyboardFocus="NameTextBox_LostKeyboardFocus"/>
                                        </Grid>
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            FontSize="9"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                        >
                                            <Run Text="{Binding ContentLength, Mode=OneWay}"/>
                                            <Run Text=" caracteres"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Ações -->
                                    <StackPanel
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                    >
                                        <!-- Setas empilhadas. O handler impede que um duplo -->
                                        <!-- clique numa seta desabilitada (que não recebe o -->
                                        <!-- evento) chegue ao card e cole o item. -->
                                        <StackPanel
                                            Orientation="Vertical"
                                            VerticalAlignment="Center"
                                            Margin="0"
                                            Background="Transparent"
                                            MouseLeftButtonDown="ArrowButtons_MouseLeftButtonDown"
                                        >
                                            <Button
                                                Content="&#xE70E;"
                                                Style="{StaticResource ArrowIconButtonStyle}"
                                                Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Id}"
                                                ToolTip="Mover para cima"/>
                                            <Button
                                                Content="&#xE70D;"
                                                Style="{StaticResource ArrowIconButtonStyle}"
                                                Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Id}"
                                                ToolTip="Mover para baixo"/>
                                        </StackPanel>
                                        <Button
                                            Content="&#xE8AC;"
                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                            FontSize="12"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            Style="{StaticResource PinIconButtonStyle}"
                                            Command="{Binding DataContext.RenameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Id}"
                                            ToolTip="Renomear"/>
                                        <Button
                                            Content="{Binding PinButtonIcon}"
                                            Style="{StaticResource PinIconButtonStyle}"
                                            Command="{Binding DataContext.PinCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Id}"
                                            ToolTip="{Binding PinButtonText}"/>
                                        <Button
                                            Content="🗑"
                                            Style="{StaticResource DeleteIconButtonStyle}"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Id}"
                                            ToolTip="Excluir item"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Rodapé -->
                <Button
                    Grid.Row="2"
                    Content="🗑 Limpar histórico"
                    Style="{StaticResource ClearHistoryButtonStyle}"
                    Command="{Binding ClearHistoryCommand}"
                    HorizontalAlignment="Center"
                    Margin="0,12,0,0"
                    Height="34"/>
            </Grid>
        </Border>

    </Grid>
</Window>
