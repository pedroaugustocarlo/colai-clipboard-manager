<Application
    x:Class="ClipboardManager.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ClipboardManager"
    StartupUri="MainWindow.xaml"
>
    <Application.Resources>
        <!-- Paleta compartilhada entre todas as janelas do app -->
        <SolidColorBrush
            x:Key="AccentBrush"
            Color="#E46D1D"/>
        <SolidColorBrush
            x:Key="AccentSoftBrush"
            Color="#FCEADB"/>
        <SolidColorBrush
            x:Key="CardBackgroundBrush"
            Color="#FFFFFF"/>
        <SolidColorBrush
            x:Key="BorderSoftBrush"
            Color="#EFE7DF"/>
        <SolidColorBrush
            x:Key="TextPrimaryBrush"
            Color="#22212B"/>
        <SolidColorBrush
            x:Key="TextSecondaryBrush"
            Color="#8D8B9C"/>
        <SolidColorBrush
            x:Key="DangerBrush"
            Color="#E5484D"/>
        <SolidColorBrush
            x:Key="DangerSoftBrush"
            Color="#FCEBEC"/>
        <!-- Botão de ícone neutro (fechar/ocultar janela) -->
        <Style
            x:Key="NeutralIconButtonStyle"
            TargetType="Button"
        >
            <Setter
                Property="Width"
                Value="26"/>
            <Setter
                Property="Height"
                Value="26"/>
            <Setter
                Property="Background"
                Value="Transparent"/>
            <Setter
                Property="BorderThickness"
                Value="0"/>
            <Setter
                Property="Foreground"
                Value="{StaticResource TextSecondaryBrush}"/>
            <Setter
                Property="FontSize"
                Value="11"/>
            <Setter
                Property="Cursor"
                Value="Hand"/>
            <Setter
                Property="FocusVisualStyle"
                Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            CornerRadius="13"
                        >
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger
                                Property="IsMouseOver"
                                Value="True"
                            >
                                <Setter
                                    TargetName="Bg"
                                    Property="Background"
                                    Value="{StaticResource BorderSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
